# Variables `docker-compose.yml` reads. Copy to `.env` in this directory — compose looks
# for that file by name and nothing else — and fill in only what you actually have.
#
#     cp .env.example .env
#
# Two rules this file keeps:
#
#   - Nothing here is a real credential. Every value is a placeholder or a default that
#     is safe to run with locally. A `.env.example` with a working key in it is a leaked
#     key with an extra step.
#   - `.env` is gitignored (`*.env` handling in `.gitignore`), and so are every database
#     file and every directory of generated speech. The stack runs with this file absent:
#     the API comes up in demo mode and answers "not configured" where a key would have
#     gone, which is a working deployment rather than a broken one.

# --- required, or compose refuses to start ------------------------------------------
# The database password. There is deliberately no default in `docker-compose.yml`: a
# stack that silently comes up with a guessed password is a stack that gets published
# somewhere and scanned.
POSTGRES_PASSWORD=

# --- names and ports, all optional ----------------------------------------------------
POSTGRES_DB=careerguide
POSTGRES_USER=careerguide
WEB_PORT=3000
API_PORT=8000

# --- addresses the browser is told ----------------------------------------------------
# `NEXT_PUBLIC_*` is inlined into the JavaScript at build time, so these decide what a
# visitor's browser tries to reach. Change one and the web image must be rebuilt —
# `docker compose build web` — because no variable set at run time can reach a bundle
# that has already been written.
#
# On a LAN or a VM, `localhost` in a browser means that browser's own machine, so an
# address like `http://192.168.1.20:8000` is what a phone on the same wifi needs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Only the compose stack needs this, and compose already defaults it to
# `http://api:8000`: inside the web container `localhost` is that container, so a
# server-rendered `/careers` or `/sitemap.xml` cannot reach the API through the
# browser's address above. Override it here if the API sits on another host.
# BACKEND_INTERNAL_URL=http://api:8000
# Where a school's own portal address comes from: `green-school.<this>`. Locally,
# `*.careerguide.localhost` resolves with no DNS work at all; a real domain needs a
# wildcard record, that record added to the hosting project, and every resulting origin
# added to CORS_ORIGINS below. See README §4 on the portals.
NEXT_PUBLIC_TENANT_BASE_DOMAIN=careerguide.localhost
# Which origins may call the API from a browser. Comma-separated, no wildcard — the app
# drops a `*` here with a log line rather than obeying it.
# Matching is exact, so a portal served at `green-school.careerguide.localhost:3000` is
# its own origin: add each portal subdomain you actually serve here, or keep the apex
# below for pages served from `careerguide.localhost` itself.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://careerguide.localhost:3000
PUBLIC_SITE_URL=http://localhost:3000

# --- the AI guide ----------------------------------------------------------------------
# `demo` needs nothing and says so on every screen: the guide's replies come from a
# script in the repository, not from a model. Set the three below together to use a real
# one, and the deployment screen at `/app/admin/settings` will report which of the two
# this stack is running.
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# --- spoken replies --------------------------------------------------------------------
# `auto` picks the best configured provider. Microsoft's Edge endpoint answers 403 to
# datacenter egress IPs, so a stack on a hosted machine usually needs Gemini or Azure.
TTS_PROVIDER=auto
GEMINI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- mail, payments, sign-in: all optional, all inert while blank -----------------------
RESEND_API_KEY=
FROM_EMAIL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- plans ----------------------------------------------------------------------------
# The one switch for every free-plan cap. Off means the price list is published and
# nothing is turned away — which is what a checkout that has never taken money on this
# deployment should do, and a decision somebody makes on the day pricing goes live.
PLAN_LIMITS_ENFORCED=false
