# CareerGuide AI — backend configuration
# Copy this file to `backend/.env`. Every value below has a working default,
# so the app runs with no .env at all. Never commit a real .env.

# --- Database ------------------------------------------------------------------
# SQLite by default: one file, no service to run, nothing to configure.
DATABASE_URL=sqlite:///./careerguide.db

# To use a hosted PostgreSQL instead (e.g. a Supabase project), replace the line
# above. Supabase: Dashboard -> Project settings -> Database -> Connection
# string, and pick either form:
#
#   session pooler / direct, port 5432     (keeps prepared statements)
#   transaction pooler, port 6543          (what the free tier scales on)
#
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<host>:5432/postgres
#
# +psycopg is required, not optional — it is the driver in requirements.txt.
# Add ?sslmode=require if the server insists on TLS. If the password contains
# @ : / or %, URL-encode it (%40, %3A, %2F, %25) or the URL will not parse.
# Both pooler modes work as shipped: the engine recycles connections and skips
# server-side prepared statements. See the note in app/database.py.
#
# The first boot against an empty database creates every table and seeds the
# career catalogue. Turn that off once the database is ready, which is what you
# want on serverless hosting where a cold start should not run DDL:
#   .venv/Scripts/python.exe scripts/db_init.py     # prepare it once
#   DB_AUTO_SETUP=false                             # afterwards
#
# Check where you stand with:
#   .venv/Scripts/python.exe scripts/db_check.py
#
# A real URL contains the database password. Keep it in .env only — never in
# .env.example, never in source, never in a commit, never pasted into chat.
DB_AUTO_SETUP=true

# Origins allowed to call the API from a browser (the Next.js dev server).
# Add any other origin you open the site with — e.g. the friendly name below,
# which Chrome and Edge resolve to this machine without editing hosts.
CORS_ORIGINS=http://careerguide.localhost:3000,http://localhost:3000,http://127.0.0.1:3000

# --- AI provider ----------------------------------------------------------------
# AI_PROVIDER=demo uses the built-in scripted guide, needs no key, and marks every
# reply as demo-generated inside the app so nobody mistakes it for a real model.
# Any OpenAI-compatible provider works: set the three values below.
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# --- Voice responses ------------------------------------------------------------
# Two transports, the same Microsoft neural voices:
#   TTS_PROVIDER=auto    Azure when its key is set below, otherwise the free Edge
#                        read-aloud endpoint. Edge answers 403 to datacenter egress
#                        IPs, so a deployed site needs the Azure key to speak.
#   TTS_PROVIDER=edge    force Edge.
#   TTS_PROVIDER=azure   force Azure. Without a key every spoken reply then fails
#                        with a clear message instead of quietly trying Edge — that
#                        is deliberate, so a broken setup is visible.
# Both send the reply's text to Microsoft to make the audio; nothing is stored here.
TTS_PROVIDER=auto
# The key is a credential: .env only, never in a commit, never in frontend code,
# never pasted into chat. On a hosted deployment it belongs in the server's
# environment variables.
AZURE_SPEECH_KEY=
# The Speech resource's own region, e.g. eastus. The key only works in that region.
AZURE_SPEECH_REGION=
TTS_VOICE_HI=hi-IN-SwaraNeural
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_TIMEOUT_SECONDS=25

# --- Login tokens ---------------------------------------------------------------
# Tokens are random opaque strings stored in the database; nothing is signed
# with a secret, so there is no key to guard here.
SESSION_TOKEN_TTL_HOURS=720

# --- Deploying to Vercel ----------------------------------------------------------
# Vercel reads these from Project Settings -> Environment Variables (or
# `vercel env add`), never from this file, and this file must not be uploaded
# (see .vercelignore). The backend project's Root Directory is `backend`, and
# Vercel finds the FastAPI `app` in app/main.py on its own.
#
#   DATABASE_URL       required. Postgres (Supabase). The app refuses to start
#                      on Vercel with a SQLite URL, because that data would
#                      vanish between instances.
#   DB_AUTO_SETUP      false, after scripts/db_init.py has prepared the database.
#   CORS_ORIGINS       the deployed frontend origin, e.g.
#                      https://careerguide-eta.vercel.app
#   AI_PROVIDER etc.   optional. Leave demo until a real key exists; the app
#                      labels every reply as demo-generated either way.
#
# And in the frontend project: NEXT_PUBLIC_BACKEND_URL = the deployed backend
# origin above. It is baked in at build time, so set it before the build.
